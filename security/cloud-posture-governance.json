    "security-command-center",
    "cloud-logging",
    "terraform-plan-drift",
    "manual-review"
  ],
  "repository_posture": {
    "check_set_id": "AFYA-CSPM-REPOSITORY-1",
    "required_rules": [
      {"id": "POSTURE-IAM-001", "control_id": "IAM-C01"},
      {"id": "POSTURE-IAM-002", "control_id": "IAM-C02"},
      {"id": "POSTURE-IAM-003", "control_id": "CSPM-C01"},
      {"id": "POSTURE-NET-001", "control_id": "NET-C01"},
      {"id": "POSTURE-EDGE-001", "control_id": "NET-C04"},
      {"id": "POSTURE-KMS-001", "control_id": "KMS-C03"},
      {"id": "POSTURE-SEC-001", "control_id": "SEC-C02"},
      {"id": "POSTURE-STORAGE-001", "control_id": "CSPM-C01"},
      {"id": "POSTURE-GOV-001", "control_id": "GOV-C01"},
      {"id": "POSTURE-LOG-001", "control_id": "MON-C01"},
      {"id": "POSTURE-LOC-001", "control_id": "CSPM-C02"}
    ],
    "allowed_claim_scopes": [
      "repository-desired-state",
      "repository-partial"
    ],
    "allowed_sources": [
      "repository"
    ],
    "allowed_assertion_operators": [
      "equals",
      "empty",
      "contains_all"
    ]
  },
  "severity_policy": {
    "critical": {
      "max_remediation_hours": 24,
      "merge_blocking": true
    },
    "high": {
      "max_remediation_hours": 168,
      "merge_blocking": true
    },
    "medium": {
      "max_remediation_hours": 720,
      "merge_blocking": false
    },
    "low": {
      "max_remediation_hours": 2160,
      "merge_blocking": false
    }
  },
  "exception_policy": {
    "registry": "security/exceptions.json",
    "maximum_days": 90,
    "required_fields": [
      "id",
      "scope",
      "rationale",
      "compensating_controls",
      "owner",
      "approved_by",
      "tracking_url",
      "created_on",
      "expires_on"
    ]
  },
  "finding_lifecycle": {
    "registry": "security/posture-findings.json",
    "initial_status": "open",
    "allowed_statuses": [
      "open",
      "in-remediation",
      "risk-accepted",
      "resolved",
      "closed"
    ],
    "allowed_sources": [
      "repository-posture",
      "terraform-drift",
      "security-command-center",
      "manual-review"
    ],
    "active_sources": [
      "repository-posture",
      "manual-review"
    ],
    "allowed_actors": [
      "security-automation",
      "cloud-security",
      "platform",
      "application-security",
      "security-operations"
    ],
    "required_fields": [
      "id",
      "source",
      "control_id",
      "severity",
      "title",
      "owner",
      "status",
      "detected_at",
      "remediation_due_at",
      "tracking_url",
      "history"
    ],
    "allowed_transitions": {
      "open": [
        "in-remediation",
        "risk-accepted",
        "resolved"
      ],
      "in-remediation": [
        "risk-accepted",
        "resolved"
      ],
      "risk-accepted": [
        "in-remediation",
        "resolved"
      ],
      "resolved": [
        "closed",
        "in-remediation"
      ],
      "closed": []
    },
    "risk_acceptance": {
      "requires_active_exception": true,
      "allowed_exception_gates": [
        "cloud-posture",
        "terraform-drift"
      ],
      "exception_gate_by_source": {
        "repository-posture": "cloud-posture",
        "manual-review": "cloud-posture",
        "security-command-center": "cloud-posture",
        "terraform-drift": "terraform-drift"
      }
    },
    "resolution": {
      "require_attempt_per_resolved_transition": true,
      "allowed_verification_statuses": [
        "pending",
        "failed",
        "passed"
      ],
      "failed_verification_requires_evidence": true
    },
    "closure": {
      "require_independent_verifier": true,
      "minimum_evidence_items": 1
    }
  },
  "live_cloud_sources": [
    {
      "source": "cloud-asset-inventory",
      "status": "planned",
      "purpose": "Asset, IAM, metadata, location, public exposure, and drift evidence after the live GCP foundation exists."
    },
    {
      "source": "security-command-center",
      "status": "planned",
      "purpose": "Cloud posture findings and security-control observations after the live GCP foundation exists."
    }
  ],
  "live_validation_prerequisites": [
    "Bootstrap and live-validate GitHub Workload Identity Federation and deployment IAM.",
    "Apply the reviewed v0.7 Google Cloud foundation in a controlled environment.",
    "Enable reviewed Cloud Asset Inventory and Security Command Center data sources without weakening country isolation.",
    "Capture live positive, negative, drift, remediation, and closure evidence before marking live controls validated."
  ]
}
