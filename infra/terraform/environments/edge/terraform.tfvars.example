    proxy_only_subnet_name                  = "afyabridge-gh-edge-proxy-africa-south1"
    proxy_only_subnet_cidr                  = "10.20.208.0/23"
    cloud_run_service_name                  = "afyabridge-gh-prod-api"
    name_prefix                             = "afyabridge-gh-prod-edge"
    dns_zone_name                           = "afyabridge-gh-public"
    dns_zone_dns_name                       = "gh.example.com."
    hostname                                = "api.gh.example.com"
    dns_ttl                                 = 300
    cloud_armor_preview                     = true
    cloud_armor_waf_sensitivity             = 1
    cloud_armor_rate_limit_count            = 300
    cloud_armor_rate_limit_interval_seconds = 60
  }

  za = {
    edge_project_id                         = "afyabridge-za-prod-app"
    network_project_id                      = "afyabridge-za-net-host"
