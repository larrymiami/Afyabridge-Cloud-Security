    proxy_only_subnet_name                  = "afyabridge-za-edge-proxy-africa-south1"
    proxy_only_subnet_cidr                  = "10.30.208.0/23"
    cloud_run_service_name                  = "afyabridge-za-prod-api"
    name_prefix                             = "afyabridge-za-prod-edge"
    dns_zone_name                           = "afyabridge-za-public"
    dns_zone_dns_name                       = "za.example.com."
    hostname                                = "api.za.example.com"
