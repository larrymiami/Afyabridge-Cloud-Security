quota_project_id = "afyabridge-shared-network-admin"
default_region   = "africa-south1"

# example.com is an IANA-reserved documentation domain. Replace these sample
# country subdomains only after real DNS ownership and delegation are reviewed.
country_edges = {
  ke = {
    edge_project_id                         = "afyabridge-ke-prod-app"
    network_project_id                      = "afyabridge-ke-net-host"
    dns_project_id                          = "afyabridge-ke-prod-app"
    region                                  = "africa-south1"
    network_id                              = "projects/afyabridge-ke-net-host/global/networks/afyabridge-ke-shared-vpc"
    proxy_only_subnet_name                  = "afyabridge-ke-edge-proxy-africa-south1"
    proxy_only_subnet_cidr                  = "10.10.208.0/23"
    cloud_run_service_name                  = "afyabridge-ke-prod-api"
    name_prefix                             = "afyabridge-ke-prod-edge"
    dns_zone_name                           = "afyabridge-ke-public"
    dns_zone_dns_name                       = "ke.example.com."
    hostname                                = "api.ke.example.com"
    dns_ttl                                 = 300
    cloud_armor_preview                     = true
    cloud_armor_waf_sensitivity             = 1
    cloud_armor_rate_limit_count            = 300
    cloud_armor_rate_limit_interval_seconds = 60
  }

  gh = {
    edge_project_id                         = "afyabridge-gh-prod-app"
