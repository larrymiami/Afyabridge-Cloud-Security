  shared-security = {
    project_id          = "afyabridge-shared-security"
    project_name        = "AfyaBridge Shared Security"
    country             = "global"
    environment         = "shared"
    service             = "security"
    owner               = "platform-security"
    cost_center         = "shared-security"
