      "serviceAccount:afyabridge-build@afyabridge-gh-prod-app.iam.gserviceaccount.com"
    ]
    cleanup_policies = {
      retain-recent = {
        action = "KEEP"
        most_recent_versions = {
          keep_count = 20
        }
      }
      remove-untagged = {
        action = "DELETE"
        condition = {
          tag_state  = "UNTAGGED"
          older_than = "2592000s"
        }
      }
    }
  }

  za-prod-images = {
    country       = "za"
    environment   = "prod"
    project_id    = "afyabridge-za-prod-app"
