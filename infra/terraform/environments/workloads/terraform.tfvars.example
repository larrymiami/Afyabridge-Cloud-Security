      "serviceAccount:afyabridge-runtime@afyabridge-za-prod-app.iam.gserviceaccount.com"
    ]
    writer_members = [
      "serviceAccount:afyabridge-build@afyabridge-za-prod-app.iam.gserviceaccount.com"
